# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Restrict slash command sync to a specific guild during development
# Remove or leave blank to sync commands globally (takes up to 1 hour)
# DEV_GUILD_ID=123456789012345678

# Optional: Idle disconnect timeout in seconds (default: 300 = 5 minutes)
# IDLE_TIMEOUT=300

# Optional: Default volume 0–100 (default: 50)
# DEFAULT_VOLUME=50

# Optional animated banner for Now Playing embeds.
# Use a direct .gif URL that is publicly reachable by Discord.
# MUSIC_GIF_URL=https://your-host.example/music-banner.gif
